{
  "name": "fsm-platform",
  "private": true,
  "engines": {
    "node": ">=22.13 <23 || >=24.3"
  },
  "main": "expo-router/entry",
  "//": "Merge these into the Stage 0 Expo package.json. Versions are minimums to pin at install time.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "seed:users": "tsx --env-file=.env scripts/seed-users.ts",
    "test:acceptance": "tsx --env-file=.env scripts/test-seed-acceptance.ts"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.45.0",
    "@tanstack/react-query": "^5.59.0",
    "expo": "~57.0.30",
    "expo-constants": "~57.0.22",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-router": "~57.0.28",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-url-polyfill": "*",
    "react-native-web": "~0.21.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^3.0.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0"
  }
}
